<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ====================================================================
         OMEN "Carbon HUD" theme
         Near-black carbon surfaces, crimson-to-ember accent, cyan data color.
         ==================================================================== -->
    <Styles.Resources>
        <!-- Background Colors -->
        <Color x:Key="DarkBackground">#0A0A0C</Color>
        <Color x:Key="CardBackground">#131316</Color>
        <Color x:Key="SurfaceBackground">#0E0E11</Color>
        <Color x:Key="SurfaceBorder">#232329</Color>
        
        <!-- Text Colors -->
        <Color x:Key="PrimaryText">#F4F4F6</Color>
        <Color x:Key="SecondaryText">#9C9CA8</Color>
        
        <!-- Brand Colors -->
        <Color x:Key="OmenCrimson">#FF2950</Color>
        <Color x:Key="OmenBlue">#00D2FF</Color>
        <Color x:Key="OmenRed">#E31837</Color>
        <Color x:Key="OmenGreen">#3DFF6E</Color>
        
        <!-- Brushes -->
        <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackground}" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackground}" />
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorder}" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource OmenCrimson}" />
        <SolidColorBrush x:Key="OmenBlueBrush" Color="{StaticResource OmenBlue}" />
        <SolidColorBrush x:Key="OmenRedBrush" Color="{StaticResource OmenRed}" />
        <SolidColorBrush x:Key="OmenGreenBrush" Color="{StaticResource OmenGreen}" />

        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FF2147" Offset="0" />
            <GradientStop Color="#FF7A18" Offset="1" />
        </LinearGradientBrush>
    </Styles.Resources>
    
    <!-- Window Base Style -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource DarkBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    
    <!-- ==================== Cards & Panels ==================== -->
    
    <!-- Standard panel card: flat carbon slab with hairline border -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="22,20" />
        <Setter Property="BorderBrush" Value="#222228" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <!-- Interactive tile -->
    <Style Selector="Border.cardInteractive">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderBrush" Value="#222228" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Border.cardInteractive:pointerover">
        <Setter Property="Background" Value="#18181C" />
        <Setter Property="BorderBrush" Value="#59FF2950" />
    </Style>
    
    <!-- Surface card (darker recessed panel) -->
    <Style Selector="Border.surfaceCard">
        <Setter Property="Background" Value="{StaticResource SurfaceBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderBrush" Value="#1D1D22" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <!-- Inner recessed panel (nested inside cards) -->
    <Style Selector="Border.inner">
        <Setter Property="Background" Value="#0C0C0F" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderBrush" Value="#1C1C21" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <!-- Stat Card -->
    <Style Selector="Border.statCard">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="BorderBrush" Value="#222228" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <!-- Status Card -->
    <Style Selector="Border.statusCard">
        <Setter Property="Background" Value="{StaticResource SurfaceBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="#1D1D22" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <!-- Section accent bar (place left of section headers) -->
    <Style Selector="Rectangle.accentBar">
        <Setter Property="Width" Value="3" />
        <Setter Property="Fill" Value="{StaticResource AccentGradientBrush}" />
        <Setter Property="RadiusX" Value="1.5" />
        <Setter Property="RadiusY" Value="1.5" />
    </Style>
    
    <!-- Badge / status pill: angular, uppercase -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="#1FFF2950" />
        <Setter Property="BorderBrush" Value="#59FF2950" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="#FF5C77" />
    </Style>
    
    <!-- Cyan data badge variant -->
    <Style Selector="Border.badgeData">
        <Setter Property="Background" Value="#1400D2FF" />
        <Setter Property="BorderBrush" Value="#4D00D2FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Border.badgeData > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{StaticResource OmenBlueBrush}" />
    </Style>
    
    <!-- Info Banner -->
    <Style Selector="Border.infoBanner">
        <Setter Property="Background" Value="#1200D2FF" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderBrush" Value="#4000D2FF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <!-- Warning Banner -->
    <Style Selector="Border.warningBanner">
        <Setter Property="Background" Value="#14FFA226" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderBrush" Value="#59FFA226" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    
    <!-- ==================== Buttons ==================== -->
    
    <!-- Primary: crimson gradient -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FF4763" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#C71B3D" />
    </Style>
    
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="#26262C" />
        <Setter Property="Foreground" Value="#5E5E6A" />
    </Style>
    
    <!-- Danger: outlined red, fills on hover -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#66FF2950" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FF5C77" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E31837" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    
    <!-- Secondary: carbon slab -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="#1A1A1F" />
        <Setter Property="BorderBrush" Value="#2C2C33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#222229" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    
    <Style Selector="Button.secondary:pointerover">
        <Setter Property="BorderBrush" Value="#80FF2950" />
    </Style>
    
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#26FF2950" />
    </Style>
    
    <!-- Ghost -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    
    <!-- Icon button -->
    <Style Selector="Button.iconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    
    <Style Selector="Button.iconButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    
    <!-- Mode tile: selectable option slab with bottom accent on hover -->
    <Style Selector="Button.modeTile">
        <Setter Property="Background" Value="#0E0E11" />
        <Setter Property="BorderBrush" Value="#222228" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="12,16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Button.modeTile:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#16161A" />
    </Style>
    <Style Selector="Button.modeTile:pointerover">
        <Setter Property="BorderBrush" Value="#8CFF2950" />
    </Style>
    
    <!-- ==================== Navigation Rail ==================== -->
    
    <!-- Icon-only rail button -->
    <Style Selector="Button.railButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#70707C" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Button.railButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#16161A" />
    </Style>
    <Style Selector="Button.railButton:pointerover">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    
    <Style Selector="Button.railButton.active">
        <Setter Property="Background" Value="#26FF2950" />
        <Setter Property="Foreground" Value="#FF5C77" />
    </Style>
    <Style Selector="Button.railButton.active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#33FF2950" />
    </Style>
    
    <!-- Header status chip -->
    <Style Selector="Border.headerChip">
        <Setter Property="Background" Value="#121215" />
        <Setter Property="BorderBrush" Value="#222228" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    
    <!-- ==================== Typography ==================== -->
    
    <!-- Kicker: tiny uppercase accent label above titles -->
    <Style Selector="TextBlock.kicker">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="2.4" />
        <Setter Property="Foreground" Value="#FF5C77" />
    </Style>
    
    <!-- Page Header -->
    <Style Selector="TextBlock.pageHeader">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    
    <!-- Section Header -->
    <Style Selector="TextBlock.sectionHeader">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    
    <!-- Subsection Header -->
    <Style Selector="TextBlock.subsectionHeader">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    
    <!-- Label -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>
    
    <!-- Caption -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#6E6E7A" />
    </Style>
    
    <!-- Micro label: tiny uppercase column headers -->
    <Style Selector="TextBlock.micro">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="1.6" />
        <Setter Property="Foreground" Value="#5E5E6A" />
    </Style>
    
    <!-- Value -->
    <Style Selector="TextBlock.value">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    
    <!-- Large Value -->
    <Style Selector="TextBlock.valueLarge">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    
    <!-- Accent Text -->
    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="#FF5C77" />
    </Style>
    
    <!-- Data (cyan) Text -->
    <Style Selector="TextBlock.data">
        <Setter Property="Foreground" Value="{StaticResource OmenBlueBrush}" />
    </Style>
    
    <!-- Warning Text -->
    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="#FFA226" />
    </Style>
    
    <!-- Error/Critical Text -->
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{StaticResource OmenRedBrush}" />
    </Style>
    
    <!-- Success Text -->
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{StaticResource OmenGreenBrush}" />
    </Style>
    
    <!-- ==================== Form Controls ==================== -->
    
    <Style Selector="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
    </Style>
    
    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="#1A1A1F" />
        <Setter Property="BorderBrush" Value="#2C2C33" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    
    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="#1A1A1F" />
        <Setter Property="BorderBrush" Value="#2C2C33" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    
    <Style Selector="TextBox">
        <Setter Property="Background" Value="#1A1A1F" />
        <Setter Property="BorderBrush" Value="#2C2C33" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    
    <!-- ==================== Progress & Status ==================== -->
    
    <Style Selector="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Foreground" Value="{StaticResource AccentGradientBrush}" />
        <Setter Property="Background" Value="#1E1E24" />
    </Style>
    
    <Style Selector="ProgressBar.thin">
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="1.5" />
    </Style>
    
    <Style Selector="Ellipse.statusDot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
    </Style>
    
    <!-- ==================== Layout ==================== -->
    
    <Style Selector="Separator">
        <Setter Property="Background" Value="#1E1E24" />
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="Height" Value="1" />
    </Style>
    
    <Style Selector="Border.verticalSeparator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="#1E1E24" />
        <Setter Property="Margin" Value="16,4" />
    </Style>
    
    <!-- ==================== Scrollbar ==================== -->
    
    <Style Selector="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    
</Styles>
