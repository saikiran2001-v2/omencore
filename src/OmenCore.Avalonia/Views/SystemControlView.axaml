<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmenCore.Avalonia.ViewModels"
             x:Class="OmenCore.Avalonia.Views.SystemControlView"
             x:DataType="vm:SystemControlViewModel">
    
    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="1150">
            
            <!-- Page Header -->
            <StackPanel Spacing="4" Margin="0,0,0,6">
                <TextBlock Classes="kicker" Text="POWER &amp; LIGHTING" />
                <TextBlock Classes="pageHeader" Text="System Control" />
                <TextBlock Classes="label" Text="Performance modes, GPU switching, and keyboard lighting" Margin="0,2,0,0" />
            </StackPanel>
            
            <!-- Performance Mode -->
            <Border Classes="card">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Rectangle Classes="accentBar" Height="16" />
                            <TextBlock Classes="sectionHeader" Text="Performance Mode" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="64"
                                         IsVisible="{Binding IsPerformanceModeChanging}" />
                            <Border Classes="badge">
                                <TextBlock Text="{Binding CurrentPerformanceMode}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="caption" Margin="13,0,0,16"
                               Text="Select a performance profile to optimize for your workload" />
                    
                    <Grid ColumnDefinitions="*,*,*,*">
                        <Button Grid.Column="0" Classes="modeTile" Margin="0,0,10,0"
                                Command="{Binding SetPerformanceModeCommand}" CommandParameter="Default"
                                IsEnabled="{Binding CanSetPerformanceMode}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="DEFAULT" FontSize="14" FontWeight="Bold" LetterSpacing="1.5"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Classes="caption" Text="Firmware default" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="modeTile" Margin="0,0,10,0"
                                Command="{Binding SetPerformanceModeCommand}" CommandParameter="Balanced"
                                IsEnabled="{Binding CanSetPerformanceMode}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="BALANCED" FontSize="14" FontWeight="Bold" LetterSpacing="1.5"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource OmenBlueBrush}" />
                                <TextBlock Classes="caption" Text="Everyday use" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="modeTile" Margin="0,0,10,0"
                                Command="{Binding SetPerformanceModeCommand}" CommandParameter="Performance"
                                IsEnabled="{Binding CanSetPerformanceMode}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="PERFORMANCE" FontSize="14" FontWeight="Bold" LetterSpacing="1.5"
                                           HorizontalAlignment="Center" Foreground="#FF5C77" />
                                <TextBlock Classes="caption" Text="Max power" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Classes="modeTile"
                                Command="{Binding SetPerformanceModeCommand}" CommandParameter="Cool"
                                IsEnabled="{Binding CanSetPerformanceMode}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="COOL" FontSize="14" FontWeight="Bold" LetterSpacing="1.5"
                                           HorizontalAlignment="Center" Foreground="#45C7FF" />
                                <TextBlock Classes="caption" Text="Quiet and cool" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- GPU Mode -->
            <Border Classes="card" IsVisible="{Binding HasGpuMuxSwitch}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Rectangle Classes="accentBar" Height="16" />
                            <TextBlock Classes="sectionHeader" Text="GPU Mode" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="badgeData" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentGpuMode}" />
                        </Border>
                    </Grid>
                    <TextBlock Classes="caption" Margin="13,0,0,16"
                               Text="Switch between hybrid and discrete GPU modes. Requires system restart." />
                    
                    <Grid ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0" Classes="secondary" Content="Hybrid"
                                Command="{Binding SetGpuModeCommand}" CommandParameter="hybrid"
                                IsEnabled="{Binding !IsGpuModeChanging}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Classes="secondary" Content="Discrete Only"
                                Command="{Binding SetGpuModeCommand}" CommandParameter="discrete"
                                IsEnabled="{Binding !IsGpuModeChanging}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,10,0" />
                        <Button Grid.Column="2" Classes="secondary" Content="Integrated Only"
                                Command="{Binding SetGpuModeCommand}" CommandParameter="integrated"
                                IsEnabled="{Binding !IsGpuModeChanging}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </Grid>
                    
                    <ProgressBar IsIndeterminate="True" 
                                 IsVisible="{Binding IsGpuModeChanging}"
                                 Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            
            <!-- NVIDIA Settings -->
            <Border Classes="card" IsVisible="{Binding HasNvidiaSettings}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Classes="accentBar" Height="16" />
                            <TextBlock Classes="sectionHeader" Text="NVIDIA Settings" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="caption" Margin="13,4,0,0"
                                   Text="Open nvidia-settings to adjust PowerMizer, overclocking, and other GPU options." />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="secondary" Content="Open nvidia-settings"
                            Command="{Binding LaunchNvidiaSettingsCommand}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Keyboard Lighting -->
            <Border Classes="card" IsVisible="{Binding HasKeyboardBacklight}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                        <Rectangle Classes="accentBar" Height="16" />
                        <TextBlock Classes="sectionHeader" Text="Keyboard Lighting" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="13,0,0,16"
                               Text="Brightness, animations, and per-zone RGB colors" />
                    
                    <!-- Brightness -->
                    <Border Classes="inner" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="micro" Text="BRIGHTNESS" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding KeyboardBrightness, StringFormat={}{0}%}" 
                                           Foreground="#FF5C77" FontWeight="Bold" FontSize="13" />
                            </Grid>
                            <Slider Value="{Binding KeyboardBrightness}" 
                                    Minimum="0" Maximum="100"
                                    Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Animation -->
                    <Border Classes="inner" Margin="0,0,0,10"
                            IsVisible="{Binding CanSetKeyboardAnimation}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="micro" Text="ANIMATION" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Text="{Binding CurrentKeyboardAnimation}" />
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <ComboBox Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding KeyboardAnimations}"
                                          SelectedIndex="{Binding SelectedKeyboardAnimationIndex, Mode=TwoWay}" />
                                <Button Grid.Column="1" Classes="primary" Content="APPLY"
                                        Command="{Binding SetKeyboardAnimationCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Color Presets -->
                    <Border Classes="inner" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Classes="micro" Text="COLOR PRESETS" Margin="0,0,0,10" />
                            <WrapPanel Orientation="Horizontal">
                                <Button Command="{Binding SetPresetColorCommand}" CommandParameter="blue"
                                        Background="#00BFFF" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="4"
                                        ToolTip.Tip="OMEN Blue" />
                                <Button Command="{Binding SetPresetColorCommand}" CommandParameter="red"
                                        Background="#E31837" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="4"
                                        ToolTip.Tip="OMEN Red" />
                                <Button Command="{Binding SetPresetColorCommand}" CommandParameter="green"
                                        Background="#39FF14" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="4"
                                        ToolTip.Tip="Neon Green" />
                                <Button Command="{Binding SetPresetColorCommand}" CommandParameter="purple"
                                        Background="#9D4EDD" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="4"
                                        ToolTip.Tip="Purple" />
                                <Button Command="{Binding SetPresetColorCommand}" CommandParameter="orange"
                                        Background="#FF6B35" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="4"
                                        ToolTip.Tip="Orange" />
                                <Button Command="{Binding SetPresetColorCommand}" CommandParameter="cyan"
                                        Background="#00FFFF" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="4"
                                        ToolTip.Tip="Cyan" />
                                <Button Command="{Binding SetPresetColorCommand}" CommandParameter="yellow"
                                        Background="#FFFF00" Width="40" Height="40" Margin="0,0,8,0" CornerRadius="4"
                                        ToolTip.Tip="Yellow" />
                                <Button Command="{Binding SetPresetColorCommand}" CommandParameter="white"
                                        Background="#FFFFFF" Width="40" Height="40" CornerRadius="4"
                                        ToolTip.Tip="White" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- 4-Zone RGB — laid out like the physical keyboard -->
                    <Border Classes="inner" IsVisible="{Binding HasFourZoneRgb}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="micro" Text="4-ZONE RGB" />
                                    <TextBlock Classes="caption" Margin="0,4,0,0"
                                               Text="Zones are arranged below exactly as they appear on the keyboard. Click a zone to pick its color." />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Content="APPLY ALL ZONES"
                                        Command="{Binding ApplyKeyboardColorCommand}"
                                        VerticalAlignment="Top" />
                            </Grid>
                            
                            <!-- Keyboard strip: physical order left to right is
                                 Zone 3 (left edge) | Zone 4 (WASD) | Zone 2 (middle) | Zone 1 (right + numpad) -->
                            <Border Background="#08080A" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                                    BorderBrush="#1C1C21" BorderThickness="1">
                                <Grid ColumnDefinitions="0.9*,1.1*,1.8*,1.5*" RowDefinitions="Auto,Auto">
                                    
                                    <!-- Zone 3 — Left edge -->
                                    <Button Grid.Column="0" Grid.Row="0" Height="84" Margin="0,0,6,0"
                                            CornerRadius="5" Padding="0" BorderThickness="1"
                                            BorderBrush="#33FFFFFF"
                                            Background="{Binding ZoneColors[2].PreviewBrush}"
                                            ToolTip.Tip="Zone 3 — Esc / Tab / Ctrl column">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <ColorPicker Color="{Binding ZoneColors[2].Color, Mode=TwoWay}"
                                                             IsAlphaVisible="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                        <Border Background="#99000000" CornerRadius="3" Padding="7,3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="ZONE 3" FontSize="10" FontWeight="Bold" LetterSpacing="1" Foreground="White" />
                                        </Border>
                                    </Button>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Classes="caption" Text="Left edge"
                                               HorizontalAlignment="Center" Margin="0,7,6,0" />
                                    
                                    <!-- Zone 4 — WASD -->
                                    <Button Grid.Column="1" Grid.Row="0" Height="84" Margin="0,0,6,0"
                                            CornerRadius="5" Padding="0" BorderThickness="1"
                                            BorderBrush="#33FFFFFF"
                                            Background="{Binding ZoneColors[3].PreviewBrush}"
                                            ToolTip.Tip="Zone 4 — WASD cluster">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <ColorPicker Color="{Binding ZoneColors[3].Color, Mode=TwoWay}"
                                                             IsAlphaVisible="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                        <Border Background="#99000000" CornerRadius="3" Padding="7,3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="ZONE 4" FontSize="10" FontWeight="Bold" LetterSpacing="1" Foreground="White" />
                                        </Border>
                                    </Button>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Classes="caption" Text="WASD"
                                               HorizontalAlignment="Center" Margin="0,7,6,0" />
                                    
                                    <!-- Zone 2 — Middle -->
                                    <Button Grid.Column="2" Grid.Row="0" Height="84" Margin="0,0,6,0"
                                            CornerRadius="5" Padding="0" BorderThickness="1"
                                            BorderBrush="#33FFFFFF"
                                            Background="{Binding ZoneColors[1].PreviewBrush}"
                                            ToolTip.Tip="Zone 2 — G row through the middle of the keyboard">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <ColorPicker Color="{Binding ZoneColors[1].Color, Mode=TwoWay}"
                                                             IsAlphaVisible="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                        <Border Background="#99000000" CornerRadius="3" Padding="7,3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="ZONE 2" FontSize="10" FontWeight="Bold" LetterSpacing="1" Foreground="White" />
                                        </Border>
                                    </Button>
                                    <TextBlock Grid.Column="2" Grid.Row="1" Classes="caption" Text="Middle"
                                               HorizontalAlignment="Center" Margin="0,7,6,0" />
                                    
                                    <!-- Zone 1 — Right + numpad -->
                                    <Button Grid.Column="3" Grid.Row="0" Height="84"
                                            CornerRadius="5" Padding="0" BorderThickness="1"
                                            BorderBrush="#33FFFFFF"
                                            Background="{Binding ZoneColors[0].PreviewBrush}"
                                            ToolTip.Tip="Zone 1 — Enter column and numpad">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <ColorPicker Color="{Binding ZoneColors[0].Color, Mode=TwoWay}"
                                                             IsAlphaVisible="False" />
                                            </Flyout>
                                        </Button.Flyout>
                                        <Border Background="#99000000" CornerRadius="3" Padding="7,3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="ZONE 1" FontSize="10" FontWeight="Bold" LetterSpacing="1" Foreground="White" />
                                        </Border>
                                    </Button>
                                    <TextBlock Grid.Column="3" Grid.Row="1" Classes="caption" Text="Enter + Numpad"
                                               HorizontalAlignment="Center" Margin="0,7,0,0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- Status Message -->
            <Border Classes="infoBanner" 
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Rectangle Width="3" Fill="{DynamicResource OmenBlueBrush}" RadiusX="1.5" RadiusY="1.5" />
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
