<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmenCore.Avalonia.ViewModels"
             x:Class="OmenCore.Avalonia.Views.LongevityView"
             x:DataType="vm:LongevityViewModel">

    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="1150">

            <!-- Page Header -->
            <StackPanel Spacing="4" Margin="0,0,0,6">
                <TextBlock Classes="kicker" Text="ENDURANCE" />
                <TextBlock Classes="pageHeader" Text="Battery &amp; Longevity" />
                <TextBlock Classes="label" Text="Extend battery lifespan and reduce thermal wear" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Battery Health -->
            <Border Classes="card">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                        <Rectangle Classes="accentBar" Height="16" />
                        <TextBlock Classes="sectionHeader" Text="Battery Health" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="13,0,0,16"
                               Text="Measured from design capacity vs. current full-charge capacity" />

                    <Grid ColumnDefinitions="*,*">
                        <Border Grid.Column="0" Classes="inner" Margin="0,0,7,0">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="micro" Text="CAPACITY HEALTH" />
                                <TextBlock Text="{Binding BatteryHealthPercent, StringFormat={}{0:F1}%}"
                                           FontSize="32" FontWeight="Bold"
                                           Foreground="{DynamicResource OmenGreenBrush}" Margin="0,6,0,2" />
                                <TextBlock Text="{Binding BatteryHealthLabel}" Classes="caption" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="inner" Margin="7,0,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="micro" Text="CHARGE CYCLES" />
                                <TextBlock Text="{Binding BatteryCycleCount}"
                                           FontSize="32" FontWeight="Bold"
                                           Foreground="{DynamicResource OmenBlueBrush}" Margin="0,6,0,2" />
                                <TextBlock Text="typical lifespan: ~500–1000" Classes="caption" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Longevity Presets -->
            <Border Classes="card">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                        <Rectangle Classes="accentBar" Height="16" />
                        <TextBlock Classes="sectionHeader" Text="Longevity Presets" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="13,0,0,16" TextWrapping="Wrap"
                               Text="One-click profiles tuned for battery and thermal longevity. Eco is best for daily use on AC or battery." />

                    <Grid ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0" Classes="modeTile" Margin="0,0,10,0"
                                Command="{Binding ApplyEcoPresetCommand}">
                            <StackPanel HorizontalAlignment="Center" Spacing="5">
                                <TextBlock Text="ECO" FontSize="15" FontWeight="Bold" LetterSpacing="2"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource OmenGreenBrush}" />
                                <TextBlock Classes="caption" Text="Cool profile" HorizontalAlignment="Center" />
                                <TextBlock Classes="caption" Text="15W CPU cap" HorizontalAlignment="Center" />
                                <TextBlock Classes="caption" Text="80% charge limit" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="modeTile" Margin="0,0,10,0"
                                Command="{Binding ApplyBalancedPresetCommand}">
                            <StackPanel HorizontalAlignment="Center" Spacing="5">
                                <TextBlock Text="BALANCED" FontSize="15" FontWeight="Bold" LetterSpacing="2"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource OmenBlueBrush}" />
                                <TextBlock Classes="caption" Text="Balanced profile" HorizontalAlignment="Center" />
                                <TextBlock Classes="caption" Text="28W CPU cap" HorizontalAlignment="Center" />
                                <TextBlock Classes="caption" Text="85% charge limit" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="modeTile"
                                Command="{Binding ApplyPerformancePresetCommand}">
                            <StackPanel HorizontalAlignment="Center" Spacing="5">
                                <TextBlock Text="PERFORMANCE" FontSize="15" FontWeight="Bold" LetterSpacing="2"
                                           HorizontalAlignment="Center"
                                           Foreground="#FF5C77" />
                                <TextBlock Classes="caption" Text="Performance profile" HorizontalAlignment="Center" />
                                <TextBlock Classes="caption" Text="45W CPU cap" HorizontalAlignment="Center" />
                                <TextBlock Classes="caption" Text="No charge limit" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CPU Power Limit -->
            <Border Classes="card" IsVisible="{Binding SupportsCpuPowerLimit}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Rectangle Classes="accentBar" Height="16" />
                            <TextBlock Classes="sectionHeader" Text="CPU Sustained Power Limit (PL1)" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="primary" Content="APPLY"
                                Command="{Binding ApplyCpuPowerLimitCommand}"
                                VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="caption" Margin="13,0,0,16" TextWrapping="Wrap"
                               Text="Limits continuous CPU power draw. Lower = cooler + longer battery life. Resets on reboot (apply preset for persistence)." />

                    <Border Classes="inner">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="micro" Text="SUSTAINED TDP" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CpuPowerLimitWatts, StringFormat={}{0}W}"
                                           Foreground="#FF5C77" FontWeight="Bold" FontSize="13" />
                            </Grid>
                            <Slider Value="{Binding CpuPowerLimitWatts}"
                                    Minimum="{Binding CpuPowerLimitMin}"
                                    Maximum="{Binding CpuPowerLimitMax}"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,6,0,6" />
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Classes="caption"
                                           Text="{Binding CpuPowerLimitMin, StringFormat={}{0}W (min)}" />
                                <TextBlock Grid.Column="2" Classes="caption"
                                           Text="{Binding CpuPowerLimitMax, StringFormat={}{0}W (max)}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Charge Limit -->
            <Border Classes="card">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                        <Rectangle Classes="accentBar" Height="16" />
                        <TextBlock Classes="sectionHeader" Text="Battery Charge Limit" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="13,0,0,16" TextWrapping="Wrap"
                               Text="Stop charging at a lower percentage to reduce battery aging. 80% is optimal for daily AC use." />

                    <!-- Sysfs-supported path -->
                    <StackPanel IsVisible="{Binding SupportsChargeLimit}">
                        <Border Classes="inner">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="micro" Text="CHARGE STOP THRESHOLD" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ChargeEndThreshold, StringFormat={}{0}%}"
                                               Foreground="#FF5C77" FontWeight="Bold" FontSize="13" />
                                </Grid>
                                <Slider Value="{Binding ChargeEndThreshold}"
                                        Minimum="60" Maximum="100"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Classes="primary" Content="APPLY CHARGE LIMIT"
                                Command="{Binding ApplyChargeLimitCommand}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- BIOS fallback guidance -->
                    <Border IsVisible="{Binding !SupportsChargeLimit}" Classes="inner">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Charge limit not exposed via sysfs on this firmware."
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Text="Set it in BIOS instead:  F10 at boot, then Advanced, then Battery Care Mode. Enable and set the limit (80% recommended)." />
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Text="Some HP OMEN models also support this via the HP Smart app on Windows. Set once and the BIOS remembers it across OS reboots." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Tips -->
            <Border Classes="card">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
                        <Rectangle Classes="accentBar" Height="16" />
                        <TextBlock Classes="sectionHeader" Text="Longevity Tips" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Spacing="8" Margin="13,0,0,0">
                        <TextBlock Classes="caption" TextWrapping="Wrap" FontSize="12"
                                   Text="Keep CPU temps below 85°C sustained — use Eco or Balanced profile for daily work." />
                        <TextBlock Classes="caption" TextWrapping="Wrap" FontSize="12"
                                   Text="Avoid charging to 100% daily — set an 80% charge limit if you're usually on AC." />
                        <TextBlock Classes="caption" TextWrapping="Wrap" FontSize="12"
                                   Text="Let the battery discharge to ~20% occasionally to keep charge-cycle reporting accurate." />
                        <TextBlock Classes="caption" TextWrapping="Wrap" FontSize="12"
                                   Text="Ensure laptop vents are clear — blocked airflow causes thermal throttling and degrades components faster." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status Message -->
            <Border Classes="infoBanner"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Rectangle Width="3" Fill="{DynamicResource OmenBlueBrush}" RadiusX="1.5" RadiusY="1.5" />
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
