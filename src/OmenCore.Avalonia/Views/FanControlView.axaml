<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmenCore.Avalonia.ViewModels"
             x:Class="OmenCore.Avalonia.Views.FanControlView"
             x:DataType="vm:FanControlViewModel">
    
    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="1150">
            
            <!-- Page Header -->
            <StackPanel Spacing="4" Margin="0,0,0,6">
                <TextBlock Classes="kicker" Text="COOLING" />
                <TextBlock Classes="pageHeader" Text="Fan Control" />
                <TextBlock Classes="label" Text="Fan profiles and real-time monitoring" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Capability Warning -->
            <Border Classes="warningBanner" IsVisible="{Binding ShowCapabilityWarning}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="!" FontSize="14" FontWeight="Bold" Foreground="#FFA226" />
                    <TextBlock Text="{Binding CapabilityWarningMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            
            <!-- Live Telemetry Tiles -->
            <Grid ColumnDefinitions="*,*,*,*">
                <Border Grid.Column="0" Classes="cardInteractive" Margin="0,0,10,0">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="micro" Text="CPU TEMP" />
                        <TextBlock Classes="value" Text="{Binding CpuTemperature, StringFormat={}{0:F0}°C}" 
                                   FontSize="27" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="cardInteractive" Margin="0,0,10,0">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="micro" Text="GPU TEMP" />
                        <TextBlock Classes="value" Text="{Binding GpuTemperature, StringFormat={}{0:F0}°C}" 
                                   FontSize="27" Margin="0,8,0,0" Foreground="{DynamicResource OmenBlueBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="cardInteractive" Margin="0,0,10,0">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="micro" Text="CPU FAN" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                            <TextBlock Classes="value" FontSize="27" Text="{Binding CpuFanRpm}" />
                            <TextBlock Text="RPM" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                       Foreground="{DynamicResource TertiaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="cardInteractive">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="micro" Text="GPU FAN" />
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                            <TextBlock Classes="value" FontSize="27" Text="{Binding GpuFanRpm}" />
                            <TextBlock Text="RPM" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                       Foreground="{DynamicResource TertiaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Fan Profiles -->
            <Border Classes="card" IsVisible="{Binding HasFanProfileAccess}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Rectangle Classes="accentBar" Height="16" />
                            <TextBlock Classes="sectionHeader" Text="Fan Profiles" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="badgeData" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveFanProfile}" />
                        </Border>
                    </Grid>
                    <TextBlock Classes="caption" Margin="13,0,0,16" TextWrapping="Wrap"
                               Text="Auto and Constant keep BIOS fan control. Max forces immediate full speed." />
                    
                    <Grid ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0" Classes="modeTile" Margin="0,0,10,0"
                                Command="{Binding SetFanProfileCommand}" CommandParameter="auto"
                                ToolTip.Tip="BIOS manages fans with balanced thermal policy">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="AUTO" FontSize="15" FontWeight="Bold" LetterSpacing="1.5"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource OmenBlueBrush}" />
                                <TextBlock Classes="caption" Text="BIOS controlled" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="modeTile" Margin="0,0,10,0"
                                Command="{Binding SetFanProfileCommand}" CommandParameter="constant"
                                ToolTip.Tip="Always BIOS auto (no fan-stop logic) for users who want continuous fan activity">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="CONSTANT" FontSize="15" FontWeight="Bold" LetterSpacing="1.5"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Classes="caption" Text="No fan-stop" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="modeTile"
                                Command="{Binding SetFanProfileCommand}" CommandParameter="max"
                                ToolTip.Tip="Immediately forces both fans to maximum speed (pwm_enable=0)">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="MAX" FontSize="15" FontWeight="Bold" LetterSpacing="1.5"
                                           HorizontalAlignment="Center" Foreground="#FF5C77" />
                                <TextBlock Classes="caption" Text="Full speed now" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Reliability Diagnostics -->
            <Border Classes="card" IsVisible="{Binding ReliabilityDiagnosticsVisible}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                        <Rectangle Classes="accentBar" Height="16" />
                        <TextBlock Classes="sectionHeader" Text="Reliability Diagnostics" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="13,0,0,12" Text="{Binding ReliabilitySummary}" TextWrapping="Wrap" />
                    <Border Classes="inner">
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReliabilityLogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="caption" Text="{Binding .}" TextWrapping="NoWrap" FontFamily="monospace" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Status Message -->
            <Border Classes="infoBanner"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Rectangle Width="3" Fill="{DynamicResource OmenBlueBrush}" RadiusX="1.5" RadiusY="1.5" />
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
