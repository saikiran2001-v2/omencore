<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmenCore.Avalonia.ViewModels"
             x:Class="OmenCore.Avalonia.Views.FanControlView"
             x:DataType="vm:FanControlViewModel">
    
    <ScrollViewer>
        <StackPanel Spacing="16">
            
            <!-- Page Header -->
            <StackPanel>
                <TextBlock Classes="pageHeader" Text="Fan Control" />
                <TextBlock Classes="label" Text="Custom fan curves, presets, and real-time monitoring" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Capability Warning -->
            <Border Classes="warningBanner" IsVisible="{Binding ShowCapabilityWarning}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="!" FontSize="14" FontWeight="Bold" />
                    <TextBlock Text="{Binding CapabilityWarningMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            
            <!-- Real-time Status Cards -->
            <Grid ColumnDefinitions="*,*,*,*">
                <Border Grid.Column="0" Classes="cardInteractive" Margin="0,0,6,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🌡️" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Classes="label" Text="CPU Temp" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Classes="value" Text="{Binding CpuTemperature, StringFormat={}{0:F0}°C}" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="cardInteractive" Margin="3,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="GPU" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Classes="label" Text="GPU Temp" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Classes="value" Text="{Binding GpuTemperature, StringFormat={}{0:F0}°C}" 
                                   HorizontalAlignment="Center" Foreground="#45C7FF" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="cardInteractive" Margin="3,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="CPU" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Classes="label" Text="CPU Fan" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Classes="value" Text="{Binding CpuFanRpm, StringFormat={}{0} RPM}" 
                                   HorizontalAlignment="Center" FontSize="16" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="cardInteractive" Margin="6,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="GPU" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Classes="label" Text="GPU Fan" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Classes="value" Text="{Binding GpuFanRpm, StringFormat={}{0} RPM}" 
                                   HorizontalAlignment="Center" FontSize="16" />
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Fan Profile Control (shown for profile-only and full-control systems) -->
            <Border Classes="card" IsVisible="{Binding HasFanProfileAccess}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="FAN" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Classes="sectionHeader" Text="Fan Profiles" VerticalAlignment="Center" Margin="0" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="0,4,0,12"
                               Text="Silent / Balanced / Gaming apply a BIOS thermal policy — fan difference is visible under CPU/GPU load, not at idle. Max forces immediate full speed." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary" Content="Auto"
                                Command="{Binding SetFanProfileCommand}" CommandParameter="auto"
                                ToolTip.Tip="BIOS manages fans with balanced thermal policy" />
                        <Button Classes="secondary" Content="Silent"
                                Command="{Binding SetFanProfileCommand}" CommandParameter="silent"
                                ToolTip.Tip="Cool/low-power thermal policy — BIOS runs fans quieter under load" />
                        <Button Classes="secondary" Content="Balanced"
                                Command="{Binding SetFanProfileCommand}" CommandParameter="balanced"
                                ToolTip.Tip="Balanced thermal policy — BIOS manages fans normally under load" />
                        <Button Classes="secondary" Content="Gaming"
                                Command="{Binding SetFanProfileCommand}" CommandParameter="gaming"
                                ToolTip.Tip="Performance thermal policy — BIOS allows higher temps and ramps fans harder under load" />
                        <Button Classes="danger" Content="Max"
                                Command="{Binding SetFanProfileCommand}" CommandParameter="max"
                                ToolTip.Tip="Immediately forces both fans to maximum speed (pwm_enable=0)" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="0,8,0,0"
                               Text="{Binding ActiveFanProfile, StringFormat='Active: {0}'}" />
                </StackPanel>
            </Border>

            <!-- Smart Auto-Switch (profile-only and full-control boards) -->
            <Border Classes="card" IsVisible="{Binding HasFanProfileAccess}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="AUTO" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Classes="sectionHeader" Text="Smart Auto-Switch" VerticalAlignment="Center" Margin="0" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutoSwitchEnabled}"
                                      OnContent="On" OffContent="Off" />
                    </Grid>
                    <TextBlock Classes="caption" Margin="0,4,0,12"
                               Text="Automatically switches fan profile based on CPU/GPU temperature. Uses the higher of CPU or GPU temp." />

                    <Border Background="#141414" CornerRadius="6" Padding="16,12">
                        <StackPanel Spacing="12">
                            <!-- Balanced threshold -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Classes="caption"
                                           Text="Switch to Balanced above:" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding ThresholdBalanced}"
                                               Minimum="50" Maximum="95" Increment="5"
                                               MinWidth="120" FormatString="0" />
                                <TextBlock Grid.Column="2" Text="°C" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                            <!-- Gaming threshold -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Classes="caption"
                                           Text="Switch to Gaming above:" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding ThresholdPerformance}"
                                               Minimum="60" Maximum="100" Increment="5"
                                               MinWidth="120" FormatString="0" />
                                <TextBlock Grid.Column="2" Text="°C" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                            <!-- Hysteresis -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Classes="caption"
                                           Text="Hysteresis (dead-band):" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding AutoSwitchHysteresis}"
                                               Minimum="0" Maximum="15" Increment="1"
                                               MinWidth="120" FormatString="0" />
                                <TextBlock Grid.Column="2" Text="°C" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                            <TextBlock Classes="caption"
                                       Text="Dead-band prevents flapping: profile only steps down once temp drops this many °C below threshold." />
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="caption" Margin="0,8,0,0"
                               Text="{Binding ActiveFanProfile, StringFormat='Current profile: {0}'}" />
                </StackPanel>
            </Border>

            <!-- Status Message -->
            <Border Classes="infoBanner"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="ℹ️" FontSize="14" />
                    <TextBlock Text="{Binding StatusMessage}" />
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
