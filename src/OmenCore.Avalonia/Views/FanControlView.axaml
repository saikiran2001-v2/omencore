<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmenCore.Avalonia.ViewModels"
             x:Class="OmenCore.Avalonia.Views.FanControlView"
             x:DataType="vm:FanControlViewModel">
    
    <ScrollViewer>
        <StackPanel Spacing="16">
            
            <!-- Page Header -->
            <StackPanel>
                <TextBlock Classes="pageHeader" Text="Fan Control" />
                <TextBlock Classes="label" Text="Custom fan curves, presets, and real-time monitoring" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Capability Warning -->
            <Border Classes="warningBanner" IsVisible="{Binding ShowCapabilityWarning}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="!" FontSize="14" FontWeight="Bold" />
                    <TextBlock Text="{Binding CapabilityWarningMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            
            <!-- Real-time Status Cards -->
            <Grid ColumnDefinitions="*,*,*,*">
                <Border Grid.Column="0" Classes="cardInteractive" Margin="0,0,6,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🌡️" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Classes="label" Text="CPU Temp" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Classes="value" Text="{Binding CpuTemperature, StringFormat={}{0:F0}°C}" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="cardInteractive" Margin="3,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="GPU" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Classes="label" Text="GPU Temp" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Classes="value" Text="{Binding GpuTemperature, StringFormat={}{0:F0}°C}" 
                                   HorizontalAlignment="Center" Foreground="#45C7FF" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="cardInteractive" Margin="3,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="CPU" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Classes="label" Text="CPU Fan" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Classes="value" Text="{Binding CpuFanRpm, StringFormat={}{0} RPM}" 
                                   HorizontalAlignment="Center" FontSize="16" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="cardInteractive" Margin="6,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="GPU" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Classes="label" Text="GPU Fan" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Classes="value" Text="{Binding GpuFanRpm, StringFormat={}{0} RPM}" 
                                   HorizontalAlignment="Center" FontSize="16" />
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Fan Profile Control (shown for profile-only and full-control systems) -->
            <Border Classes="card" IsVisible="{Binding HasFanProfileAccess}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="FAN" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Classes="sectionHeader" Text="Fan Profiles" VerticalAlignment="Center" Margin="0" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="0,4,0,12"
                               Text="Auto and Constant keep BIOS fan control. Max forces immediate full speed. No temperature-based profile switching is applied by OmenCore." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary" Content="Auto"
                                Command="{Binding SetFanProfileCommand}" CommandParameter="auto"
                                ToolTip.Tip="BIOS manages fans with balanced thermal policy" />
                        <Button Classes="secondary" Content="Constant"
                                Command="{Binding SetFanProfileCommand}" CommandParameter="constant"
                                ToolTip.Tip="Always BIOS auto (no fan-stop logic) for users who want continuous fan activity" />
                        <Button Classes="danger" Content="Max"
                                Command="{Binding SetFanProfileCommand}" CommandParameter="max"
                                ToolTip.Tip="Immediately forces both fans to maximum speed (pwm_enable=0)" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="0,8,0,0"
                               Text="{Binding ActiveFanProfile, StringFormat='Active: {0}'}" />
                </StackPanel>
            </Border>

            <!-- Status Message -->
            <Border Classes="infoBanner"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="ℹ️" FontSize="14" />
                    <TextBlock Text="{Binding StatusMessage}" />
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
