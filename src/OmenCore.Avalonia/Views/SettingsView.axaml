<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmenCore.Avalonia.ViewModels"
             x:Class="OmenCore.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    
    <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="1150">
            
            <!-- Page Header -->
            <StackPanel Spacing="4" Margin="0,0,0,6">
                <TextBlock Classes="kicker" Text="CONFIGURATION" />
                <TextBlock Classes="pageHeader" Text="Settings" />
                <TextBlock Classes="label" Text="Application configuration and preferences" Margin="0,2,0,0" />
            </StackPanel>
            
            <!-- Startup -->
            <Border Classes="card">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                        <Rectangle Classes="accentBar" Height="16" />
                        <TextBlock Classes="sectionHeader" Text="Startup" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="13,0,0,14"
                               Text="Control how OmenCore starts and behaves on system boot" />
                    
                    <Border Classes="inner" Margin="0,0,0,8">
                        <ToggleSwitch IsChecked="{Binding StartWithSystem}"
                                      OnContent="Start OmenCore when system boots"
                                      OffContent="Manual start only" />
                    </Border>
                    
                    <Border Classes="inner" Margin="0,0,0,8">
                        <ToggleSwitch IsChecked="{Binding StartMinimized}"
                                      OnContent="Start minimized to tray"
                                      OffContent="Start with window visible" />
                    </Border>
                    
                    <Border Classes="inner">
                        <ToggleSwitch IsChecked="{Binding AutoApplyProfile}"
                                      OnContent="Auto-apply last profile on startup"
                                      OffContent="Start with default settings" />
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- Defaults -->
            <Border Classes="card">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                        <Rectangle Classes="accentBar" Height="16" />
                        <TextBlock Classes="sectionHeader" Text="Defaults" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="13,0,0,14"
                               Text="Default behavior and polling configuration" />
                    
                    <Grid ColumnDefinitions="*,*">
                        <Border Grid.Column="0" Classes="inner" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Classes="micro" Text="DEFAULT PERFORMANCE MODE" Margin="0,0,0,10" />
                                <ComboBox ItemsSource="{Binding PerformanceModes}" 
                                          SelectedItem="{Binding DefaultPerformanceMode}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="1" Classes="inner" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Classes="micro" Text="SENSOR POLLING INTERVAL" Margin="0,0,0,10" />
                                <ComboBox ItemsSource="{Binding PollingIntervals}" 
                                          SelectedItem="{Binding PollingInterval}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Power Management -->
            <Border Classes="card">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                        <Rectangle Classes="accentBar" Height="16" />
                        <TextBlock Classes="sectionHeader" Text="Power Management" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="13,0,0,14"
                               Text="Adjust behavior when running on battery power" />
                    
                    <Border Classes="inner" Margin="0,0,0,8">
                        <ToggleSwitch IsChecked="{Binding BatteryAwareFans}"
                                      OnContent="Auto-quiet fans when on battery"
                                      OffContent="Same fan profile on battery" />
                    </Border>
                    
                    <Border Classes="inner">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="label" Text="Battery fan speed reduction:" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding BatteryReductionOptions}" 
                                      SelectedItem="{Binding BatterySpeedReduction}"
                                      MinWidth="100" />
                            <TextBlock Classes="label" Text="%" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- Notifications -->
            <Border Classes="card">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                        <Rectangle Classes="accentBar" Height="16" />
                        <TextBlock Classes="sectionHeader" Text="Notifications" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="13,0,0,14"
                               Text="Desktop notification preferences" />
                    
                    <Border Classes="inner">
                        <ToggleSwitch IsChecked="{Binding ShowNotifications}"
                                      OnContent="Show desktop notifications"
                                      OffContent="Notifications disabled" />
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- About -->
            <Border Classes="card">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
                        <Rectangle Classes="accentBar" Height="16" />
                        <TextBlock Classes="sectionHeader" Text="About OmenCore" VerticalAlignment="Center" />
                    </StackPanel>
                    
                    <Border Classes="inner">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="micro" Text="VERSION" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Version}" FontSize="13" FontWeight="Bold" 
                                               Foreground="#FF5C77" />
                                </StackPanel>
                                <TextBlock Classes="caption" Text="Open-source gaming laptop control for Linux" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="secondary" Content="Config Folder"
                                        Command="{Binding OpenConfigFolderCommand}" />
                                <Button Classes="primary" Content="GITHUB"
                                        Command="{Binding OpenGitHubCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- Status Message -->
            <Border Classes="infoBanner" 
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Rectangle Width="3" Fill="{DynamicResource OmenGreenBrush}" RadiusX="1.5" RadiusY="1.5" />
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            
            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="danger" Content="Reset All to Defaults" 
                        Command="{Binding ResetToDefaultsCommand}"
                        HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary" Content="Cancel" 
                            Command="{Binding CancelCommand}" />
                    <Button Classes="primary" Content="SAVE SETTINGS" 
                            Command="{Binding SaveSettingsCommand}" />
                </StackPanel>
            </Grid>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
