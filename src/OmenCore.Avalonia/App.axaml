<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmenCore.Avalonia.App"
             RequestedThemeVariant="Dark">
    
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="/Themes/OmenTheme.axaml" />
    </Application.Styles>
    
    <Application.Resources>
        <!-- ==================== OMEN Brand Colors ==================== -->
        <Color x:Key="OmenCrimson">#FF2950</Color>
        <Color x:Key="OmenBlue">#00D2FF</Color>
        <Color x:Key="OmenRed">#E31837</Color>
        <Color x:Key="OmenGreen">#3DFF6E</Color>
        <Color x:Key="OmenPurple">#9D4EDD</Color>
        <Color x:Key="OmenOrange">#FF7A18</Color>
        <Color x:Key="OmenCyan">#00FFFF</Color>
        <Color x:Key="OmenYellow">#FFD700</Color>
        
        <!-- ==================== Background Colors ==================== -->
        <Color x:Key="DarkBackground">#0A0A0C</Color>
        <Color x:Key="CardBackground">#131316</Color>
        <Color x:Key="CardBackgroundHover">#19191D</Color>
        <Color x:Key="SurfaceBackground">#0E0E11</Color>
        <Color x:Key="SurfaceBorder">#232329</Color>
        
        <!-- ==================== Text Colors ==================== -->
        <Color x:Key="PrimaryText">#F4F4F6</Color>
        <Color x:Key="SecondaryText">#9C9CA8</Color>
        <Color x:Key="TertiaryText">#5E5E6A</Color>
        <Color x:Key="AccentText">#FF2950</Color>
        
        <!-- ==================== Status Colors ==================== -->
        <Color x:Key="SuccessColor">#3DFF6E</Color>
        <Color x:Key="WarningColor">#FFA226</Color>
        <Color x:Key="ErrorColor">#FF2950</Color>
        <Color x:Key="InfoColor">#00D2FF</Color>
        
        <!-- ==================== Temperature Colors ==================== -->
        <Color x:Key="TempCold">#45C7FF</Color>
        <Color x:Key="TempWarm">#FFD700</Color>
        <Color x:Key="TempHot">#FFA226</Color>
        <Color x:Key="TempCritical">#FF2950</Color>
        
        <!-- ==================== Brushes ==================== -->
        <!-- Brand -->
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource OmenCrimson}" />
        <SolidColorBrush x:Key="OmenBlueBrush" Color="{StaticResource OmenBlue}" />
        <SolidColorBrush x:Key="OmenRedBrush" Color="{StaticResource OmenRed}" />
        <SolidColorBrush x:Key="OmenGreenBrush" Color="{StaticResource OmenGreen}" />
        <SolidColorBrush x:Key="OmenPurpleBrush" Color="{StaticResource OmenPurple}" />
        <SolidColorBrush x:Key="OmenOrangeBrush" Color="{StaticResource OmenOrange}" />
        
        <!-- Backgrounds -->
        <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackground}" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackground}" />
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorder}" />
        
        <!-- Text -->
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}" />
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryText}" />
        
        <!-- Status -->
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
        <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
        
        <!-- Temperature -->
        <SolidColorBrush x:Key="TempColdBrush" Color="{StaticResource TempCold}" />
        <SolidColorBrush x:Key="TempWarmBrush" Color="{StaticResource TempWarm}" />
        <SolidColorBrush x:Key="TempHotBrush" Color="{StaticResource TempHot}" />
        <SolidColorBrush x:Key="TempCriticalBrush" Color="{StaticResource TempCritical}" />
        
        <!-- Accent variants -->
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FF5C77" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#C71B3D" />
        <SolidColorBrush x:Key="AccentTransparentBrush" Color="#26FF2950" />
        
        <!-- Accent gradient: OMEN crimson to ember orange -->
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FF2147" Offset="0" />
            <GradientStop Color="#FF7A18" Offset="1" />
        </LinearGradientBrush>
    </Application.Resources>
</Application>
