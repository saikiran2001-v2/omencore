# OmenCore: four-zone keyboard sysfs — permissions and brightness gate init.
# Requires scripts/init-fourzone-keyboard.sh at /usr/local/lib/omencore/
# (installed by build.sh or manually — see docs/LINUX_INSTALL_GUIDE.md).
ACTION=="add|change", SUBSYSTEM=="platform", KERNEL=="hp-wmi", \
  RUN+="/usr/local/lib/omencore/init-fourzone-keyboard.sh"

# OmenCore: allow manual fan PWM writes on hp-wmi hwmon when present.
ACTION=="add|change", SUBSYSTEM=="hwmon", ATTR{name}=="hp", \
  RUN+="/bin/sh -c 'd=/sys/class/hwmon/%k; for f in pwm1 pwm1_enable; do [ -e $$d/$$f ] && chmod 0666 $$d/$$f; done; true'"
